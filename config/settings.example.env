# BIORAG example environment.
# Values here mirror current code defaults where possible. Copy to `.env` and
# change only what your local environment needs.

APP_ENV=dev

# Vector store and local model assets.
MILVUS_URI=./runtime/vectorstores/milvus/papers.db
MILVUS_COLLECTION=synbio_papers
BGE_M3_MODEL_PATH=./models/BAAI/bge-m3
BGE_EMBED_MAX_LENGTH=512
BGE_RERANKER_MODEL_PATH=./models/BAAI/bge-reranker-v2-m3

# Hybrid retrieval. Keep defaults aligned with src/synbio_rag/domain/config.py.
RETRIEVAL_HYBRID_ENABLED=true
RETRIEVAL_BM25_ENABLED=true
RETRIEVAL_SEARCH_LIMIT=40
RETRIEVAL_DENSE_LIMIT=40
RETRIEVAL_BM25_LIMIT=40
RETRIEVAL_RERANK_TOP_K=10
RETRIEVAL_FINAL_TOP_K=8
RETRIEVAL_RERANK_MODE=plain
RETRIEVAL_SCORE_FLOOR=0.05
RETRIEVAL_DENSE_RRF_WEIGHT=1.0
RETRIEVAL_BM25_RRF_WEIGHT=1.0
RETRIEVAL_CJK_QUERY_BM25_WEIGHT=0.25
RETRIEVAL_SOURCE_FLOOR_ENABLED=true
RETRIEVAL_SOURCE_FLOOR_DENSE_TOP_N=3
RETRIEVAL_SOURCE_FLOOR_BM25_TOP_N=3
RETRIEVAL_SOURCE_FLOOR_MAX_CANDIDATES_TOTAL=6
RETRIEVAL_ALIAS_EXPANSION_ENABLED=false

# Parent and neighbor expansion. generation_v2 uses parent expansion by default;
# neighbor expansion remains available for legacy generation and v2 audit setup.
RETRIEVAL_PARENT_EXPANSION_ENABLED=true
RETRIEVAL_PARENT_INDEX_PATH=./data/paper_round1/chunks/parent_index.jsonl
RETRIEVAL_PARENT_EXPANSION_MAX_TOTAL=12
RETRIEVAL_PARENT_EXPANSION_PER_SEED_LIMIT=2
RETRIEVAL_PARENT_EXPANSION_WINDOW_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_CAPTION_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_PAGE_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_SECTION_PATH_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_EVIDENCE_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_SUMMARY_SECTIONS_ENABLED=true
RETRIEVAL_PARENT_EXPANSION_SUMMARY_SECTIONS=Abstract,Conclusion,Conclusions,Results,Results and Discussion
RETRIEVAL_NEIGHBOR_EXPANSION_ENABLED=true
RETRIEVAL_NEIGHBOR_WINDOW_SIZE=2
RETRIEVAL_NEIGHBOR_EXPANSION_MAX_CHUNKS=30

# Phase 20 / rewrite-related retrieval flags. Production default keeps query
# rewrite and original-CN fallback off.
QUERY_REWRITE_MODE=off
QUERY_REWRITE_MODEL=qwen-plus
QUERY_REWRITE_TEMPERATURE=0.0
QUERY_REWRITE_CACHE_ENABLED=true
QUERY_REWRITE_CACHE_TTL_SECONDS=86400
QUERY_REWRITE_CACHE_KEY_VERSION=v1_guarded
QUERY_REWRITE_TIMEOUT_MS=3000
QUERY_REWRITE_FALLBACK_ON_ERROR=true
QUERY_REWRITE_GUARD_IMPLICIT_REFERENCE=true
QUERY_REWRITE_GUARD_NEGATIVE_INTENT=true
QUERY_REWRITE_TRACE_ENABLED=true
QUERY_REWRITE_REQUIRE_LLM_FOR_EVAL=false
EVAL_REWRITE_CACHE_PATH=
EVAL_REWRITE_REQUIRE_CACHE=false
EVAL_REWRITE_FAIL_FAST_ON_MISSING=false
RETRIEVAL_ORIGINAL_CN_FALLBACK_ENABLED=false
RETRIEVAL_ORIGINAL_CN_FALLBACK_DENSE_TOP_N=2
RETRIEVAL_ORIGINAL_CN_FALLBACK_BM25_TOP_N=2
RETRIEVAL_ORIGINAL_CN_FALLBACK_MAX_TOTAL=4

# Generation. Current default is generation_v2. `old` remains an explicit
# legacy fallback but is not the default.
GENERATION_VERSION=v2
GENERATION_V2_PROFILE=stable
GENERATION_V2_USE_QWEN_SYNTHESIS=false
GENERATION_V2_ENABLE_COMPARISON_COVERAGE=false
GENERATION_V2_ENABLE_NEIGHBOR_AUDIT=false
GENERATION_V2_QWEN_SYNTHESIS_TIMEOUT_SECONDS=30
GENERATION_V2_QWEN_SYNTHESIS_MAX_CHARS_PER_EVIDENCE=1200
GENERATION_V2_QWEN_SYNTHESIS_MAX_OUTPUT_CHARS=3000
GENERATION_V2_USE_EXTERNAL_TOOLS=false
GENERATION_V2_USE_HISTORY=false
GENERATION_V2_MAX_SUPPORT_FACTOID=3
GENERATION_V2_MAX_SUPPORT_SUMMARY=5
GENERATION_V2_MAX_SUPPORT_COMPARISON=6
GENERATION_V2_MAX_EXTRACTIVE_EVIDENCE_LINES=6
GENERATION_V2_MIN_SUPPORT_SCORE=0.0
GENERATION_V2_REQUIRE_CITATION=true
GENERATION_V2_NEIGHBOR_WINDOW=1
GENERATION_V2_MAX_NEIGHBORS_PER_SEED=2
GENERATION_V2_NEIGHBOR_PROMOTION_DRY_RUN=true
GENERATION_V2_NEIGHBOR_SCORE_DECAY_DISTANCE1=0.45
GENERATION_V2_NEIGHBOR_SCORE_DECAY_DISTANCE2=0.25
GENERATION_V2_NEIGHBOR_MIN_PROMOTION_SCORE=0.05

# Phase7 table evidence preview. This is not a production table citation path.
TABLE_PREVIEW_ENABLED=true
TABLE_PREVIEW_UNITS_PATH=./data/experiments/v7_phase7_table_index_unit_qa/phase7j_preview_eligible_units.jsonl
TABLE_PREVIEW_MAX_CANDIDATES=20
TABLE_PREVIEW_MERGE_ENABLED=true
TABLE_PREVIEW_MERGE_STRATEGY=type_aware_merge_v1
TABLE_PREVIEW_MERGE_MAX_CANDIDATES=5
TABLE_PREVIEW_MIN_SCORE=0.05
TABLE_PREVIEW_ALLOW_FORMAL_CITATION=false

# Table enhancement for ingestion builds. Default is off.
TABLE_ENHANCEMENT_ENABLED=false
TABLE_ENHANCEMENT_MODE=conservative_caption_nearby
TABLE_ENHANCEMENT_WINDOW_AFTER_CAPTION=5
TABLE_ENHANCEMENT_WINDOW_BEFORE_CAPTION=1
TABLE_ENHANCEMENT_MAX_ASSOCIATED_BLOCKS_PER_CAPTION=5
TABLE_ENHANCEMENT_MIN_CONFIDENCE=low
TABLE_ENHANCEMENT_WRITE_AUDIT=true
TABLE_ENHANCEMENT_FAIL_ON_SCHEMA_DRIFT=true
TABLE_ENHANCEMENT_OUTPUT_SUFFIX=table_enhanced
TABLE_ENHANCEMENT_AUDIT_ROOT=./reports/table_enhancement
TABLE_ENHANCEMENT_DRY_RUN=false

# Qwen / OpenAI-compatible endpoints for answer synthesis and query rewrite.
QWEN_CHAT_API_BASE=
QWEN_CHAT_API_KEY=

# Round8 flags belong to the explicit old generation path. Keep disabled unless
# intentionally testing that legacy path.
ROUND8_ENABLE_ROUND8_POLICY=false
ROUND8_DISABLE_COMPARISON_SINGLE_DOC_HARD_REFUSAL=false
ROUND8_ENABLE_CLAIM_FALLBACK=false
ROUND8_ENABLE_PARTIAL_ANSWER=false
ROUND8_ENABLE_ROUTE_SPECIFIC_THRESHOLDS=false
ROUND8_ENABLE_COMPARISON_PROMPT_V2=false
ROUND8_ENABLE_CITATION_EXPANSION=false
ROUND8_ENABLE_RAGAS_RETRY=false

# Audit and session persistence.
AUDIT_LOG_PATH=./runtime/logs/rag_audit.jsonl
SESSION_STORE_PATH=./runtime/logs/session_store.json
